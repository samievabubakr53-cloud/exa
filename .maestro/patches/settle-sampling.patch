@@ -0,0 +1,70 @@
+package maestro.utils
+
+import com.google.common.truth.Truth.assertThat
+import io.mockk.every
+import io.mockk.mockk
+import maestro.DeviceInfo
+import maestro.Driver
+import maestro.TreeNode
+import maestro.ViewHierarchy
+import maestro.device.Platform
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+
+class ScreenshotUtilsTimingTest {
+    private val sleeps = mutableListOf<Long>()
+    private val timer = MaestroTimer.sleep
+    private val driver = mockk<Driver>()
+    private val first = TreeNode(attributes = mutableMapOf("text" to "first", "bounds" to "[0,0][100,100]"), children = emptyList())
+    private val second = first.copy(attributes = first.attributes.toMutableMap().apply { put("text", "second") })
+
+    @BeforeEach
+    fun setUp() {
+        every { driver.deviceInfo() } returns DeviceInfo(Platform.WEB, 100, 100, 100, 100)
+        MaestroTimer.setTimerFunc { _, duration -> sleeps.add(duration) }
+    }
+
+    @AfterEach
+    fun tearDown() {
+        MaestroTimer.setTimerFunc(timer)
+    }
+
+    @Test
+    fun `delays both fresh samples when no initial hierarchy is available`() {
+        every { driver.contentDescriptor(false) } returns first
+
+        val settled = ScreenshotUtils.waitForAppToSettle(null, driver, hierarchyDelayMs = 300)
+
+        assertThat(settled).isEqualTo(ViewHierarchy(first))
+        assertThat(sleeps).containsExactly(300L, 300L).inOrder()
+    }
+
+    @Test
+    fun `delays the comparison with an existing hierarchy`() {
+        every { driver.contentDescriptor(false) } returns first
+
+        ScreenshotUtils.waitForAppToSettle(ViewHierarchy(first), driver, hierarchyDelayMs = 300)
+
+        assertThat(sleeps).containsExactly(300L)
+    }
+
+    @Test
+    fun `preserves the extra polling delay after a hierarchy change`() {
+        every { driver.contentDescriptor(false) } returnsMany listOf(first, second, second)
+
+        val settled = ScreenshotUtils.waitForAppToSettle(null, driver, hierarchyDelayMs = 300)
+
+        assertThat(settled).isEqualTo(ViewHierarchy(second))
+        assertThat(sleeps).containsExactly(300L, 300L, 200L, 300L).inOrder()
+    }
+
+    @Test
+    fun `adds no sample delay for other drivers`() {
+        every { driver.contentDescriptor(false) } returnsMany listOf(first, second, second)
+
+        ScreenshotUtils.waitForAppToSettle(null, driver)
+
+        assertThat(sleeps).containsExactly(200L)
+    }
+}
